# Rendered to Caddyfile.generated by scripts/aws_deploy.sh (SITE_ADDRESS and the optional password block).
__SITE_ADDRESS__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), usb=(), microphone=(self), payment=(self)"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://www.overleaf.com https://*.razorpay.com"
		-Server
		-X-Powered-By
	}
__AUTH_BLOCK__
	# API + Server-Sent Events: flush immediately so live progress streams aren't buffered.
	handle /api/* {
		request_body {
			max_size 45MB
		}
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}

__WWW_REDIRECT__
