# Rendered to Caddyfile.generated by scripts/aws_deploy.sh (SITE_ADDRESS and the optional password block).
__SITE_ADDRESS__ {
	encode zstd gzip
__AUTH_BLOCK__
	# API + Server-Sent Events: flush immediately so live progress streams aren't buffered.
	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
