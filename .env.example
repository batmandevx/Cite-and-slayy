# Copy to .env and fill in. Never commit .env.

# --- LLM (claim support, cluster labels, research questions, reviewer jury) ---
# auto (default) = local Ollama model first (free, no API cost), else the first cloud key below, else none
# anthropic | openai | gemini | ollama | none   (none = LLM features report "not assessed")
LLM_PROVIDER=auto
# Optional override. Defaults: anthropic=claude-opus-5-5, openai=gpt-4.1-mini, gemini=gemini-2.5-flash
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local, free, offline: install https://ollama.com, `ollama pull qwen3.5:9b`, keep `ollama serve` running
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# --- Scholarly APIs (all free) ---
# Your real email: identifies you to Crossref/OpenAlex "polite pools" (faster, more reliable)
CONTACT_EMAIL=
# Free key from https://www.semanticscholar.org/product/api  (strongly recommended)
S2_API_KEY=
OPENALEX_API_KEY=

# --- Optional ---
GROBID_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only accept tortured-phrase rows that your team has signed off (verified_by column)
TORTURED_REQUIRE_VERIFIED=false

# --- AutoResearchClaw bridge (external dependency) ---
AUTOCLAW_BIN=researchclaw
AUTOCLAW_CONFIG=
AUTOCLAW_WORKDIR=
# true = the Draft tab replays the cached showcase run instead of a ~1h live pipeline
DEMO_MODE=true

CORS_ORIGINS=http://localhost:3000

# ---------- Accounts, plans & payments (production) ----------
# Require sign-in for the app and API. Keep false for local hacking; set true once a sign-in method below is configured.
AUTH_REQUIRED=false
PUBLIC_URL=https://your-domain.example
# API_PUBLIC_URL=http://localhost:8000      # local dev only, when the API is on another port
# SECRET_KEY=                                # signs session cookies (generated into DATA_DIR if empty)
# Google sign-in: create an OAuth "Web application" client ID in Google Cloud Console (Authorized JS origin = PUBLIC_URL)
GOOGLE_CLIENT_ID=
# Email magic links (e.g. Amazon SES SMTP credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# DEV_SHOW_MAGIC_LINK=true                   # local testing only: shows the link instead of emailing it
# Pro/Max engine (papers and verdicts on paid plans). Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=
# PREMIUM_MODEL=claude-opus-5-5
# Razorpay (Dashboard -> Account & Settings -> API keys; Webhooks -> secret, events subscription.*)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cost metering: USD per 1M tokens for models without built-in prices, and the INR rate used for plan budgets
# PRICE_OVERRIDES={"moonshotai.kimi-k2.5": [IN, OUT]}   # fill from the Bedrock pricing page
# USD_INR=88
# OPENALEX_API_KEY=                          # free key from openalex.org; strongly recommended in production
